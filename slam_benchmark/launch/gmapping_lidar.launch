<launch>
  <!-- Stage 9 Gmapping baseline with scan remapped only inside the SLAM node. -->
  <arg name="scan_source" default="lidar"/>
  <arg name="scan_topic" default="/lidar/scan"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="map"/>
  <arg name="use_sim_time" default="true"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping_lidar" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam command="load" file="$(find slam_benchmark)/config/gmapping_lidar.yaml"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
  </node>
</launch>
