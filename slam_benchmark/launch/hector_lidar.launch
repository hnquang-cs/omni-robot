<launch>
  <!-- Stage 9 Hector comparison. Uses hector_map and /map_hector to avoid /map conflicts. -->
  <arg name="scan_topic" default="/lidar/scan"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="hector_map"/>
  <arg name="map_topic" default="/map_hector"/>
  <arg name="use_sim_time" default="true"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping_lidar" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <remap from="map" to="$(arg map_topic)"/>
    <remap from="map_metadata" to="$(arg map_topic)_metadata"/>
    <rosparam command="load" file="$(find slam_benchmark)/config/hector_lidar.yaml"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
  </node>
</launch>
