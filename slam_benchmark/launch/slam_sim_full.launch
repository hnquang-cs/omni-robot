<launch>
  <!-- Full Stage 7 simulation bringup for SLAM tuning. -->
  <arg name="use_rviz" default="true"/>
  <arg name="use_gazebo" default="true"/>
  <arg name="gazebo_gui" default="true"/>
  <arg name="use_gmapping" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_gazebo_model_controller" default="true"/>
  <arg name="use_gazebo_truth_odom" default="true"/>
  <arg name="use_slam_scan_profile" default="true"/>
  <arg name="gmapping_profile" default="conservative"/>
  <arg name="model_name" default="omni_robot"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="map"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include if="$(arg use_gazebo)" file="$(find robot_description)/launch/gazebo_sim.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gazebo_gui)"/>
  </include>

  <include if="$(arg use_gazebo_truth_odom)" file="$(find omni_base_controller)/launch/controller.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="use_rviz" value="false"/>
    <arg name="load_description" value="false"/>
    <arg name="publish_odom" value="false"/>
    <arg name="publish_tf" value="false"/>
  </include>

  <include unless="$(arg use_gazebo_truth_odom)" file="$(find omni_base_controller)/launch/controller.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="use_rviz" value="false"/>
    <arg name="load_description" value="false"/>
    <arg name="publish_odom" value="true"/>
    <arg name="publish_tf" value="true"/>
  </include>

  <group if="$(arg use_gazebo)">
    <include if="$(arg use_gazebo_model_controller)" file="$(find omni_base_controller)/launch/gazebo_model_controller.launch">
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <arg name="model_name" value="$(arg model_name)"/>
      <arg name="cmd_vel_topic" value="/cmd_vel"/>
    </include>

    <include if="$(arg use_gazebo_truth_odom)" file="$(find omni_base_controller)/launch/gazebo_truth_odom.launch">
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <arg name="model_name" value="$(arg model_name)"/>
      <arg name="odom_topic" value="/odom"/>
      <arg name="odom_frame" value="$(arg odom_frame)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="publish_tf" value="true"/>
    </include>
  </group>

  <include if="$(arg use_slam_scan_profile)" file="$(find stereo_pipeline)/launch/stereo_slam_pipeline.launch">
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="target_frame" value="base_link"/>
  </include>

  <include unless="$(arg use_slam_scan_profile)" file="$(find stereo_pipeline)/launch/stereo_sim_pipeline.launch">
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="target_frame" value="base_link"/>
  </include>

  <group if="$(arg use_gmapping)">
    <include if="$(eval arg('gmapping_profile') == 'conservative')" file="$(find slam_benchmark)/launch/gmapping_conservative.launch">
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <arg name="scan_topic" value="$(arg scan_topic)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="odom_frame" value="$(arg odom_frame)"/>
      <arg name="map_frame" value="$(arg map_frame)"/>
    </include>

    <include if="$(eval arg('gmapping_profile') == 'fast')" file="$(find slam_benchmark)/launch/gmapping_fast.launch">
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <arg name="scan_topic" value="$(arg scan_topic)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="odom_frame" value="$(arg odom_frame)"/>
      <arg name="map_frame" value="$(arg map_frame)"/>
    </include>

    <include if="$(eval arg('gmapping_profile') == 'baseline')" file="$(find slam_benchmark)/launch/gmapping_sim.launch">
      <arg name="scan_topic" value="$(arg scan_topic)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="odom_frame" value="$(arg odom_frame)"/>
      <arg name="map_frame" value="$(arg map_frame)"/>
    </include>
  </group>

  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz_slam"
        args="-d $(find slam_benchmark)/rviz/slam_tuning.rviz" required="false"/>
</launch>
