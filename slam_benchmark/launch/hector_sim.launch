<launch>
  <!-- Stage 7 Hector SLAM comparison entry point. Do not run with Gmapping by default. -->
  <arg name="scan_topic" default="/scan"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="hector_map"/>
  <arg name="map_topic" default="/map_hector"/>
  <arg name="use_sim_time" default="false"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <remap from="map" to="$(arg map_topic)"/>
    <remap from="map_metadata" to="$(arg map_topic)_metadata"/>
    <rosparam command="load" file="$(find slam_benchmark)/config/hector_params.yaml"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
  </node>
</launch>
