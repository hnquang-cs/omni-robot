Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Class: rviz/TF
      Enabled: true
      Name: TF
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Enabled: true
      Name: LiDAR Scan
      Topic: /lidar/scan
      Size (m): 0.03
      Style: Points
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
    - Class: rviz/Odometry
      Enabled: true
      Name: Odometry
      Topic: /odom
  Enabled: true
  Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1200
