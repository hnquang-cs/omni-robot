Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
      Alpha: 0.7
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Enabled: true
      Name: LiDAR Scan
      Topic: /lidar/scan
      Style: Points
      Size (m): 0.035
      Color Transformer: FlatColor
      Color: 255; 30; 30
    - Class: rviz/Odometry
      Enabled: true
      Name: Odometry
      Topic: /odom
      Shape: Arrow
  Enabled: true
  Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 30
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1200
