<launch>
  <!-- Gazebo LiDAR simulation using the Stage 10 navigation-fixed arena. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="world_name" default="$(find robot_description)/worlds/test_arena_nav_fixed.world"/>

  <include file="$(find robot_description)/launch/gazebo_lidar_sim.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world_name" value="$(arg world_name)"/>
  </include>
</launch>
