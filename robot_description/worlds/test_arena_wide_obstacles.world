<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="test_arena_wide_obstacles">
    <!-- Wide Stage 9 final arena: 12 m x 10 m floor, corridor plus open lobby. -->
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="wide_floor_12x10">
      <static>true</static>
      <pose>0 0 -0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0 10.0 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0 10.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls. missing_wall_stage9_fixed closes the rear side kept open in the old small arena. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.12 1.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.12 1.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 10.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 10.0 1.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="missing_wall_stage9_fixed">
      <static>true</static>
      <pose>-6.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 10.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 10.0 1.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.75 1</ambient><diffuse>0.55 0.55 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main corridor: x=-5.0..1.2, y=-1.25..1.25, open toward the lobby. -->
    <model name="wall_corridor_north">
      <static>true</static>
      <pose>-2.1 1.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.8 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.8 0.12 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_corridor_south">
      <static>true</static>
      <pose>-2.1 -1.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.8 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.8 0.12 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Open room/lobby: x=1.2..5.8, y=-4.5..4.5, with partial dividers but no blocked loop. -->
    <model name="wall_lobby_divider_north">
      <static>true</static>
      <pose>2.2 2.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
          <material><ambient>0.58 0.62 0.70 1</ambient><diffuse>0.58 0.62 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_lobby_divider_south">
      <static>true</static>
      <pose>3.5 -2.2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.12 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.12 1.5</size></box></geometry>
          <material><ambient>0.58 0.62 0.70 1</ambient><diffuse>0.58 0.62 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static box obstacle list: obstacle_box_01 .. obstacle_box_07. -->
    <model name="obstacle_box_01">
      <static>true</static>
      <pose>2.4 0.9 0.4 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><ambient>0.80 0.20 0.20 1</ambient><diffuse>0.80 0.20 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_02">
      <static>true</static>
      <pose>4.4 -0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.5 1.0</size></box></geometry><material><ambient>0.20 0.60 0.25 1</ambient><diffuse>0.20 0.60 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_03">
      <static>true</static>
      <pose>1.8 -3.25 0.4 0 0 0.7</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.3 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.3 0.8</size></box></geometry><material><ambient>0.20 0.35 0.80 1</ambient><diffuse>0.20 0.35 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_04">
      <static>true</static>
      <pose>-3.8 2.7 0.5 0 0 -0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.5 1.0</size></box></geometry><material><ambient>0.80 0.65 0.20 1</ambient><diffuse>0.80 0.65 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_05">
      <static>true</static>
      <pose>-4.1 -2.8 0.4 0 0 1.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.3 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.3 0.8</size></box></geometry><material><ambient>0.65 0.25 0.75 1</ambient><diffuse>0.65 0.25 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_06">
      <static>true</static>
      <pose>4.6 3.2 0.4 0 0 -0.55</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><ambient>0.15 0.70 0.75 1</ambient><diffuse>0.15 0.70 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_07">
      <static>true</static>
      <pose>-1.6 3.55 0.5 0 0 0.1</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.5 1.0</size></box></geometry><material><ambient>0.85 0.45 0.20 1</ambient><diffuse>0.85 0.45 0.20 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
