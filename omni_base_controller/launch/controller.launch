<launch>
  <!-- Controller bringup for Stage 4 kinematic testing. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="use_rviz" default="false"/>
  <arg name="publish_odom" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="load_description" default="true"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(find omni_base_controller)/config/omni_params.yaml" ns="omni_kinematics"/>
  <param name="omni_kinematics/publish_odom" value="$(arg publish_odom)"/>
  <param name="omni_kinematics/publish_tf" value="$(arg publish_tf)"/>
  <param name="omni_kinematics/cmd_vel_topic" value="$(arg cmd_vel_topic)"/>

  <group if="$(arg load_description)">
    <param name="robot_description" command="$(find xacro)/xacro $(find robot_description)/urdf/omni_robot.urdf.xacro"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="publish_frequency" value="30.0"/>
    </node>
  </group>

  <node pkg="omni_base_controller" type="omni_kinematics.py" name="omni_kinematics" output="screen">
    <remap from="/cmd_vel" to="$(arg cmd_vel_topic)"/>
  </node>

  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find robot_description)/rviz/robot.rviz" required="false"/>
</launch>
