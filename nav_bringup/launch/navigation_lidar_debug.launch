<launch>
  <!-- Stage 10 debug navigation profile: wide map, small footprint, low inflation, no recovery. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="map_file" default="$(find nav_bringup)/maps/lidar_baseline_wide.yaml"/>
  <arg name="scan_topic" default="/lidar/scan"/>
  <arg name="use_rviz" default="true"/>
  <arg name="gazebo_gui" default="true"/>
  <arg name="model_name" default="omni_robot"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include file="$(find robot_description)/launch/gazebo_lidar_nav_fixed.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gazebo_gui)"/>
  </include>

  <include file="$(find omni_base_controller)/launch/gazebo_model_controller.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="model_name" value="$(arg model_name)"/>
    <arg name="cmd_vel_topic" value="/cmd_vel"/>
  </include>

  <include file="$(find omni_base_controller)/launch/gazebo_truth_odom.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="model_name" value="$(arg model_name)"/>
    <arg name="odom_topic" value="/odom"/>
    <arg name="odom_frame" value="$(arg odom_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="publish_tf" value="true"/>
  </include>

  <include file="$(find nav_bringup)/launch/navigation_lidar.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="map_file" value="$(arg map_file)"/>
  </include>

  <include file="$(find nav_bringup)/launch/amcl_lidar.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="odom_frame" value="$(arg odom_frame)"/>
  </include>

  <node pkg="move_base" type="move_base" name="move_base" output="screen" required="false">
    <remap from="cmd_vel" to="/cmd_vel"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam command="load" file="$(find nav_bringup)/config/costmap_common_lidar_debug.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/global_costmap_lidar_debug.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/local_costmap_lidar_debug.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/move_base_lidar.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/global_planner_debug.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/teb_omni_smooth.yaml"/>
    <param name="recovery_behavior_enabled" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
  </node>

  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz_navigation_goal_debug"
        args="-d $(find nav_bringup)/rviz/navigation_goal_debug.rviz" required="false"/>
</launch>
