<launch>
  <!-- AMCL owns map->odom during navigation; do not run together with Gmapping. -->
  <arg name="scan_topic" default="/lidar/scan"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="global_frame" default="map"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam command="load" file="$(find nav_bringup)/config/amcl_lidar.yaml"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="global_frame_id" value="$(arg global_frame)"/>
  </node>
</launch>
