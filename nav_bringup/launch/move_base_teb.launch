<launch>
  <!-- move_base with GlobalPlanner and TEB configured for the omni LiDAR baseline. -->
  <arg name="scan_topic" default="/lidar/scan"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="use_sim_time" default="true"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="move_base" type="move_base" name="move_base" output="screen" required="false">
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam command="load" file="$(find nav_bringup)/config/costmap_common_lidar.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/global_costmap_lidar.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/local_costmap_lidar.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/move_base_lidar.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/global_planner.yaml"/>
    <rosparam command="load" file="$(find nav_bringup)/config/teb_omni.yaml"/>
  </node>
</launch>
