Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
    - Class: rviz/TF
      Enabled: true
      Name: TF
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Enabled: true
      Name: LiDAR Scan
      Topic: /lidar/scan
      Size (m): 0.03
      Style: Points
    - Class: rviz/PoseArray
      Enabled: true
      Name: AMCL Particles
      Topic: /particlecloud
    - Class: rviz/Map
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
    - Class: rviz/Map
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
    - Class: rviz/Path
      Enabled: true
      Name: Global Plan
      Topic: /move_base/GlobalPlanner/plan
    - Class: rviz/Path
      Enabled: true
      Name: Local Plan
      Topic: /move_base/TebLocalPlannerROS/local_plan
    - Class: rviz/Pose
      Enabled: true
      Name: Goal
      Topic: /move_base_simple/goal
    - Class: rviz/Odometry
      Enabled: true
      Name: Odometry
      Topic: /odom
  Enabled: true
  Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 10
Window Geometry:
  Height: 900
  Width: 1400
